# Public site URL (Vercel domain in split deploy — no trailing slash)
APP_URL=http://localhost:3000

# --- Vercel (frontend) only ---
# Public Railway URL of the backend, e.g. https://repairo-production.up.railway.app
# When set, Next.js rewrites /api/* to Railway.
BACKEND_URL=

# --- Railway (backend) — required ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=./data/repairo.db

# GitHub OAuth App callback must be:
#   {APP_URL}/api/auth/callback
# e.g. https://your-app.vercel.app/api/auth/callback

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Vendor OpenAPI polling (optional)
# Secure cron: GET /api/cron/poll-vendors with Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# Or in-process poller on Railway (ms, min 60000), e.g. 3600000 = hourly
VENDOR_POLL_MS=

# Sarvam AI — powers the "Otto" chat assistant widget (/api/chat). Without this,
# the widget responds with "not configured on the server". Get a key at
# https://dashboard.sarvam.ai (format: sk_...).
SARVAM_API_KEY=
# Optional: override Otto's model. Defaults to sarvam-105b-conversations, which
# answers directly. Do NOT use sarvam-105b here: it is a reasoning model that
# returns content:null with finish_reason "length" when its thinking pass eats
# the token budget.
SARVAM_MODEL=
# Optional: override the API base URL (defaults to https://api.sarvam.ai/v1)
SARVAM_BASE_URL=
# Optional: Sarvam "thinking mode". Leave unset for the chat widget — an unbounded
# reasoning pass can spend the whole token budget and return an empty answer.
# Set to `none` if the model reasons by default. Diagnose with: npm run otto:ping
SARVAM_REASONING_EFFORT=

# Anthropic (Claude) — used ONLY by the optional CLI `--agent-resolve` enum-mapping
# pass. Without this, --agent-resolve is a no-op. Not used by the chat widget.
ANTHROPIC_API_KEY=

# --- Google Auth (Auth.js / NextAuth) — landing-page beta waitlist ---
# Generate: npx auth secret   OR   openssl rand -base64 32
AUTH_SECRET=
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional fallback if AUTH_GOOGLE_ID is unset (also used on Vercel today):
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
#
# Authorized redirect URIs in Google Cloud Console must include:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-VERCEL-DOMAIN/api/auth/callback/google
#
# After adding these on Vercel, redeploy so they take effect.

# --- GitHub App (webhooks at /api/github/webhooks on Vercel, or `npm run dev:github-app`) ---
# Public slug from https://github.com/apps/<slug> — powers the "Install GitHub App" CTA
NEXT_PUBLIC_GITHUB_APP_SLUG=repairo-ai
# From https://github.com/settings/apps → your app → "App ID"
APP_ID=
# Contents of the downloaded .pem. Either quote it as multi-line, or paste it
# on one line with literal \n between lines.
PRIVATE_KEY=
# The "Webhook secret" you typed when creating the app
WEBHOOK_SECRET=
# Port for the standalone webhook server (`npm run dev:github-app` only)
PORT=3000
# SQLite path for GitHub App state (installations, PR comment ids). On Vercel defaults to /tmp.
GITHUB_APP_DATABASE_PATH=./data/repairo-github-app.db
# GitHub App settings → Webhook URL: {APP_URL}/api/github/webhooks
# Optional: path to an `oasdiff` binary; without it the built-in diff engine is used
OASDIFF_BIN=
