{
  "openapi": "3.0.0",
  "info": {
    "title": "OpenAI API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Creates a model response for the given chat conversation.",
        "parameters": [
          {
            "name": "max_tokens",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "max_tokens": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
