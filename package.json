{
  "name": "repairo-cli",
  "version": "0.3.0",
  "description": "Repairo detects breaking changes in third-party APIs, maps codebase impact, and generates validated AST repairs.",
  "private": false,
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "repairo": "./bin/repairo.js",
    "repairo-cli": "./bin/repairo.js"
  },
  "files": [
    "bin/",
    "src/cli/",
    "src/lib/engine/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx tsx tests/run-tests.ts && npx tsx tests/github-app.test.mts",
    "repairo": "npx tsx src/cli/index.ts",
    "demo:engine": "npx tsx src/lib/engine/run-demo.ts",
    "test:spec-diff": "npx tsx tests/spec-diff.test.ts",
    "test:oasdiff": "npx tsx tests/oasdiff.test.ts",
    "test:github-app": "npx tsx tests/github-app.test.mts",
    "dev:github-app": "tsx watch src/github-app/index.ts",
    "start:github-app": "tsx src/github-app/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@octokit/app": "^16.1.4",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "better-sqlite3": "^13.0.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "js-yaml": "^4.3.1",
    "lodash.isequal": "^4.5.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.11",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "brace-expansion": "^2.0.1",
    "js-yaml": "^4.3.1"
  }
}
