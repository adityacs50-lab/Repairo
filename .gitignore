# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# vendored design catalog (clone locally; see docs/design-references/README.md)
/_vendor/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local data
/data

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Security scan artifacts
repairo-sbom.json
# Business and legal documents — never belong in a repo that publishes a package
*.pdf
*.xlsx
*.docx

# Local scratch and agent output
/_to_delete/
/Claude outputs/
/.repairo/
/repairo-demo/

# Packed CLI tarballs (build output of `npm pack`)
*.tgz
